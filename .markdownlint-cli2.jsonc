{
  // Relaxed rules that fit prose-style working notes for the planning team.
  "config": {
    "default": true,
    // Prose lines are not wrapped at a fixed width.
    "MD013": false,
    // Allow inline HTML where the SVG/graphic references need it.
    "MD033": false,
    // The first line is not required to be a top-level heading in every file.
    "MD041": false,
    // Duplicate sibling headings are fine across working notes.
    "MD024": { "siblings_only": true }
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules"]
}
